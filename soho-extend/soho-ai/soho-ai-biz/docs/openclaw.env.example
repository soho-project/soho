# Openclaw OpenAI-compatible config
# Replace the values below with your actual deployment settings.

# Base URL of this AI gateway
OPENAI_BASE_URL=http://localhost:6677/ai/guest/openai/v1

# Some clients use OPENAI_API_BASE instead of OPENAI_BASE_URL.
OPENAI_API_BASE=http://localhost:6677/ai/guest/openai/v1

# Create this key from: POST /ai/user/apiKey
OPENAI_API_KEY=replace_with_your_ai_user_api_key

# Default model
OPENAI_MODEL=gpt-5.4

# Optional request defaults
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096

# Openclaw should call:
# POST ${OPENAI_BASE_URL}/chat/completions
# Authorization: Bearer ${OPENAI_API_KEY}
